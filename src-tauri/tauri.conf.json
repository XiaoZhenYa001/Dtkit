{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DtKit",
  "version": "0.1.5",
  "identifier": "com.administrator.dtkit",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DtKit",
        "width": 1000,
        "height": 600
      },
      {
        "label": "desktop-organizer",
        "title": "桌面整理",
        "url": "desktop-organizer/index.html",
        "width": 550,
        "height": 450,
        "minWidth": 400,
        "minHeight": 300,
        "resizable": true,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "center": false,
        "shadow": false,
        "x": 1350,
        "y": 10
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
